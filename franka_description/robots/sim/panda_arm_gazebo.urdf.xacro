<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="panda">
  <xacro:arg name="arm_id" default="panda"/>
  <xacro:arg name="hand" default="true"/>
  <xacro:arg name="initial_positions" default="0.0 ${-pi/4} 0.0 ${-3*pi/4} 0.0 ${pi/2} ${pi/4}"/>
  <xacro:arg name="controllers_config" default="$(find franka_moveit_config)/config/sim_gazebo_panda_ros_controllers.yaml"/>
  <xacro:include filename="$(find franka_description)/robots/common/panda_arm.xacro"/>
  <link name="world"/> 
  <xacro:panda_arm arm_id="$(arg arm_id)" connected_to="world" safety_distance="0.03" add_inertials="true"/>
  <xacro:if value="$(arg hand)">
    <xacro:include filename="$(find franka_description)/robots/common/hand.xacro"/>
    <xacro:hand ns="$(arg arm_id)" rpy="0 0 ${-pi/4}" connected_to="$(arg arm_id)_link8" safety_distance="0.03" add_inertials="true"/>
  </xacro:if>
  <xacro:include filename="$(find franka_description)/robots/sim/panda_arm_gazebo.ros2_control.xacro"/>
  <xacro:panda_arm_gazebo_ros2_control ns="$(arg arm_id)" hand="$(arg hand)" initial_positions="$(arg initial_positions)" controllers_config="$(arg controllers_config)"/>
</robot>
